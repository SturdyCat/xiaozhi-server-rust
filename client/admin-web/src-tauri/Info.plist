<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  正式引用（W14b-1，M6）：tauri.conf.json 的 bundle.macOS.infoPlist 指向本文件，
  打包时与 Tauri 默认 Info.plist 合并（tauri-utils MacConfig::info_plist）。
  NSAllowsLocalNetworking：macOS 15 ATS 对 WKWebView 的 WS 升级拦截放宽
  （架构文档 §1.1①；localhost/127.0.0.1 的 per-domain 例外不覆盖 WebSocket 升级）。
  ⚠️ 实际是否生效（含 app-sandbox / 签名组合）仍需真机复核（架构文档 §3-L3 第 1/2 项）。
-->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>小智管理台需要使用麦克风进行设备语音调试</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>小智管理台需要访问局域网以发现设备</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_xiaozhi._tcp</string>
  </array>
  <key>NSAllowsLocalNetworking</key>
  <true/>
</dict>
</plist>
