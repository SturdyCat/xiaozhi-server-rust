      "name": "reminder_countdown",
      "templates": ["{delay}后提醒我{task}", "过{delay}提醒我{task}", "{delay}之后提醒我{task}"],
      "action": {
        "kind": "plan",
        "reply": "",
        "plan": {"conditions": [], "steps": [
          {"api": "tasks.create", "args": {"text": "{{slots.task}}", "after": "{{slots.delay}}", "timezone": "Asia/Shanghai"}},
          {"api": "replies.say", "args": {"text": "{{steps.0.speech}}"}}
        ]}
      }
    },
    {
